# Copy to .env for local development. Never commit the real file.
NODE_ENV=development
LOG_LEVEL=info

# Donut-compatible upstream. Keep the token server-side in local secrets or Railway.
DONUT_API_BASE_URL=https://api.example.invalid
DONUT_API_KEY=replace-in-local-secret-storage
DONUT_SOURCE_KEY=mirror-primary
DONUT_SOURCE_DISPLAY_NAME=Donut-compatible mirror
COLLECTOR_MODE=continuous
COLLECTOR_REQUESTS_PER_MINUTE=200
COLLECTOR_TRANSACTION_RESERVE_PERCENT=60
COLLECTOR_TRANSACTION_PAGES=10
COLLECTOR_TRANSACTION_POLL_MS=15000
COLLECTOR_LISTING_ENABLED=false
COLLECTOR_LISTING_MAX_PAGES=25
COLLECTOR_LISTING_SCAN_BUDGET_MS=10000
COLLECTOR_LISTING_POLL_MS=60000
COLLECTOR_MAX_RUN_BACKOFF_MS=300000
COLLECTOR_LEASE_TTL_MS=60000

# PostgreSQL
DATABASE_URL=postgresql://donut:donut@localhost:5432/donut_market
DATABASE_SSL=false
PGSSLMODE=disable
DATABASE_MAX_CONNECTIONS=10
OUTBOX_POLL_MS=1000

# Hosted API and private owner authentication.
API_HOST=0.0.0.0
API_PORT=3001
PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001
SESSION_COOKIE_NAME=donut_session
SESSION_SECRET=replace-with-at-least-32-random-bytes
TOKEN_HASH_SECRET=replace-with-a-different-32-byte-random-secret
OWNER_EMAIL=owner@example.invalid
# Generate locally with the documented password utility; never paste a password here.
OWNER_PASSWORD_HASH=scrypt$replace-with-generated-hash
SELLER_PRIVACY_DEFAULT=owner_full_invited_hidden
SELLER_PSEUDONYM_SECRET=replace-with-a-separate-32-byte-random-secret
METRICS_BEARER_TOKEN=replace-with-a-dedicated-monitoring-token
EXPOSE_OPENAPI=true

# Optional application build metadata.
APP_VERSION=dev
COLLECTOR_VERSION=dev

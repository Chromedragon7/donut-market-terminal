{
  "name": "@donut/collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "start": "node dist/main.js",
    "once": "node dist/main.js --once"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@donut/compatible-api": "workspace:*",
    "@donut/db": "workspace:*",
    "@donut/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

{
  "name": "@donut/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node dist/src/index.js",
    "test": "tsc -p tsconfig.json && node --test dist/test/api.test.js dist/test/postgres-repository.test.js dist/test/postgres.integration.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "hash-password": "tsx src/cli/hash-password.ts"
  },
  "dependencies": {
    "@donut/db": "workspace:*",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.5.1",
    "fastify": "5.6.2"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
